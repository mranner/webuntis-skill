def cmd_setup(args):
    if os.path.exists(CONFIG_PATH) and not args.force:
        print(f"{CONFIG_PATH} existiert bereits (--force zum Ueberschreiben).")
        cfg = config_laden()
    else:
        server = args.server or input("Server (z.B. schule.webuntis.com): ").strip()
        school = args.school or input("Schulkuerzel (z.B. schule): ").strip()
        username = args.username or input("Benutzername (E-Mail): ").strip()
        cfg = {"server": server, "school": school, "username": username}
        with open(CONFIG_PATH, "w", encoding="utf-8") as fh:
            json.dump(cfg, fh, ensure_ascii=False, indent=2)
            fh.write("\n")
        os.chmod(CONFIG_PATH, 0o600)
        print(f"Konfiguration geschrieben: {CONFIG_PATH}")
    passwort_holen(cfg["username"])
    print("Passwort liegt im Schluesselbund.")
    client = Client(cfg)
    client.sicherstellen()
    print("Login erfolgreich.")
    for s in schueler_liste(client):
        print(f"  Kind: {s['name']} (id {s['id']})")


