def cmd_timetable(args, client):
    client.sicherstellen()
    if args.klasse:
        ziel = klasse_waehlen(client, args.klasse)
        typ = ELEMENT_KLASSE
        titel = f"Klasse {ziel['name']}"
    else:
        ziel = schueler_waehlen(client, args.student)
        typ = ELEMENT_SCHUELER
        titel = ziel["name"]

    von = datum(args.date)
    bis = von + timedelta(days=args.days - 1)
    perioden, namen = wochenplan(client, typ, ziel["id"], von, bis)

    nach_tag = {}
    for p in perioden:
        tag = datetime.strptime(str(p["date"]), "%Y%m%d").date()
        if von <= tag <= bis:
            nach_tag.setdefault(tag, []).append(p)

    if args.json:
        ausgabe({"ziel": ziel, "typ": typ,
                 "tage": {str(t): v for t, v in sorted(nach_tag.items())},
                 "namen": {f"{k[0]}:{k[1]}": v for k, v in namen.items()}}, True)
        return

    print(f"Stundenplan {titel} -- {von} bis {bis}")
    if not nach_tag:
        print("\nKeine Daten.")
        if typ == ELEMENT_SCHUELER:
            print("Solange die Schuelerzuordnung fehlt, hilft der Klassenplan:")
            print("  webuntis timetable --class 2a")
        return
    for tag in sorted(nach_tag):
        print(f"\n{WOCHENTAG[tag.weekday()]} {tag:%d.%m.%Y}")
        for p in sorted(nach_tag[tag], key=lambda x: x["startTime"]):
            print("  " + periode_zeile(p, namen))


def cmd_news(args, client):
    client.sicherstellen()
    tag = datum(args.date)
    daten = client.hole_json(
        f"/api/public/news/newsWidgetData?date={tag:%Y%m%d}",
        zweck="Tagesnachrichten",
    )["data"]
    meldungen = daten.get("messagesOfDay") or []
    if ausgabe(meldungen, args.json):
        return
    if not meldungen:
        print(f"Keine Tagesnachrichten fuer {tag}.")
        return
    for m in meldungen:
        print(f"\n## {m.get('subject')}")
        print(entschaerfen(m.get("text") or ""))


def entschaerfen(html):
    import re
    text = re.sub(r"<br\s*/?>", "\n", html)
    text = re.sub(r"</p>", "\n", text)
    text = re.sub(r"<[^>]+>", "", text)
    import html as html_mod
    return html_mod.unescape(text).strip()


def cmd_homework(args, client):
    client.sicherstellen()
    von = datum(args.date)
    bis = von + timedelta(days=args.days - 1)
    daten = client.hole_json(
        f"/api/homeworks/lessons?startDate={von:%Y%m%d}&endDate={bis:%Y%m%d}",
        zweck="Hausaufgaben",
    )["data"]
    kinder = {s["id"]: s["name"] for s in schueler_liste(client)}
    zuordnung = {r["homeworkId"]: r.get("elementIds") or []
                 for r in daten.get("records") or []}
    if args.student:
        kind = schueler_waehlen(client, args.student)
        daten["homeworks"] = [h for h in daten.get("homeworks") or []
                              if kind["id"] in zuordnung.get(h["id"], [])]
        daten["records"] = [r for r in daten.get("records") or []
                            if kind["id"] in (r.get("elementIds") or [])]
    aufgaben = daten.get("homeworks") or []
    if ausgabe(daten, args.json):
        return
    if not aufgaben:
        print(f"Keine Hausaufgaben zwischen {von} und {bis}.")
        return
    faecher = {l["id"]: l.get("subject") for l in daten.get("lessons", [])}
    for h in aufgaben:
        fach = faecher.get(h.get("lessonId"), "?")
        wer = ", ".join(kinder.get(i, str(i)) for i in zuordnung.get(h["id"], [])) or "?"
        print(f"{h.get('dueDate')}\t{wer}\t{fach}\t{h.get('text')}")


