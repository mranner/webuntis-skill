#!/usr/bin/env python3
"""webuntis -- Lesezugriff auf WebUntis fuer Erziehungsberechtigte.

Stdlib only (Python >= 3.11). Login ueber das Web-Formular
(/WebUntis/j_spring_security_check), danach Cookie-Session plus
Bearer-Token (/WebUntis/api/token/new) fuer die REST-Endpunkte.
Passwort liegt im macOS-Schluesselbund, nie in der Konfiguration.
"""

import argparse
import getpass
import http.cookiejar
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
import uuid
from datetime import date, datetime, timedelta

SKILL_DIR = os.path.dirname(os.path.abspath(__file__))
CONFIG_PATH = os.environ.get("WEBUNTIS_CONFIG", os.path.join(SKILL_DIR, "webuntis.json"))
STATE_DIR = os.path.expanduser("~/.cache/webuntis-skill")
KEYCHAIN_SERVICE = "webuntis"
USER_AGENT = "webuntis-skill/1.0 (+claude-code)"


class Fehler(Exception):
    pass


# --------------------------------------------------------------------------
# Konfiguration und Passwort
# --------------------------------------------------------------------------

def config_laden():
    if not os.path.exists(CONFIG_PATH):
        raise Fehler(
            f"Keine Konfiguration unter {CONFIG_PATH}.\n"
            f"Anlegen mit: python3 \"{SKILL_DIR}/webuntis\" setup"
        )
    with open(CONFIG_PATH, encoding="utf-8") as fh:
        cfg = json.load(fh)
    for pflicht in ("server", "school", "username"):
        if not cfg.get(pflicht):
            raise Fehler(f"Feld '{pflicht}' fehlt in {CONFIG_PATH}.")
    return cfg


def passwort_lesen(username):
    res = subprocess.run(
        ["security", "find-generic-password", "-s", KEYCHAIN_SERVICE,
         "-a", username, "-w"],
        capture_output=True, text=True,
    )
    if res.returncode != 0:
        return None
    return res.stdout.rstrip("\n")


def passwort_anlegen(username):
    """Legt den Keychain-Eintrag an; security fragt selbst auf dem TTY."""
    if not sys.stdin.isatty():
        raise Fehler(
            "Kein Passwort im Schluesselbund und keine interaktive Shell.\n"
            "Einmalig im Terminal ausfuehren:\n"
            f"  security add-generic-password -U -s {KEYCHAIN_SERVICE} "
            f"-a {username} -w"
        )
    print(f"Kein Schluesselbund-Eintrag fuer {username}.", file=sys.stderr)
    print("Passwort wird jetzt abgefragt und im Schluesselbund abgelegt.",
          file=sys.stderr)
    res = subprocess.run(
        ["security", "add-generic-password", "-U", "-s", KEYCHAIN_SERVICE,
         "-a", username, "-w"]
    )
    if res.returncode != 0:
        raise Fehler("Anlegen im Schluesselbund fehlgeschlagen.")
    pw = passwort_lesen(username)
    if not pw:
        raise Fehler("Eintrag angelegt, aber nicht lesbar.")
    return pw


def passwort_holen(username):
    return passwort_lesen(username) or passwort_anlegen(username)


# --------------------------------------------------------------------------
# Client
# --------------------------------------------------------------------------

class Client:
    def __init__(self, cfg):
        self.server = cfg["server"].rstrip("/")
        self.school = cfg["school"]
        self.username = cfg["username"]
        self.base = f"https://{self.server}/WebUntis"
        os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
        sichere = "".join(c if c.isalnum() else "_" for c in
                          f"{self.server}-{self.username}")
        self.cookie_path = os.path.join(STATE_DIR, f"{sichere}.cookies")
        self.jar = http.cookiejar.LWPCookieJar(self.cookie_path)
        if os.path.exists(self.cookie_path):
            try:
                self.jar.load(ignore_discard=True)
            except Exception:
                pass
        self.opener = urllib.request.build_opener(
            urllib.request.HTTPCookieProcessor(self.jar)
        )
        self._token = None

    # -- HTTP ---------------------------------------------------------------

    def _roh(self, methode, pfad, daten=None, headers=None, content_type=None):
        url = pfad if pfad.startswith("http") else self.base + pfad
        kopf = {"User-Agent": USER_AGENT, "Accept": "application/json"}
        if headers:
            kopf.update(headers)
        koerper = None
        if daten is not None:
            if content_type == "form":
                koerper = urllib.parse.urlencode(daten).encode()
                kopf["Content-Type"] = "application/x-www-form-urlencoded"
            elif content_type == "multipart":
                koerper, grenze = multipart_bauen(daten)
                kopf["Content-Type"] = f"multipart/form-data; boundary={grenze}"
            else:
                koerper = json.dumps(daten).encode()
                kopf["Content-Type"] = "application/json"
        req = urllib.request.Request(url, data=koerper, headers=kopf,
                                     method=methode)
        try:
            with self.opener.open(req, timeout=30) as antwort:
                return antwort.status, antwort.read().decode("utf-8", "replace")
        except urllib.error.HTTPError as err:
            return err.code, err.read().decode("utf-8", "replace")
        except urllib.error.URLError as err:
            raise Fehler(f"Verbindung zu {self.server} fehlgeschlagen: {err.reason}")

    def _speichern(self):
        self.jar.save(ignore_discard=True)
        os.chmod(self.cookie_path, 0o600)

    # -- Login --------------------------------------------------------------

    def login(self):
        passwort = passwort_holen(self.username)
        self._roh("GET", f"/?school={urllib.parse.quote(self.school)}")
        status, text = self._roh(
            "POST", "/j_spring_security_check",
            daten={"school": self.school, "j_username": self.username,
                   "j_password": passwort, "token": ""},
            content_type="form",
        )
        erfolg = False
        try:
            erfolg = json.loads(text).get("state") == "SUCCESS"
        except Exception:
            erfolg = status in (200, 302) and "j_spring_security_check" not in text
        if not erfolg:
            raise Fehler(
                "Login abgelehnt. Passwort im Schluesselbund pruefen:\n"
                f"  security add-generic-password -U -s {KEYCHAIN_SERVICE} "
                f"-a {self.username} -w"
            )
        self._token = None
        self._speichern()

    def _angemeldet(self):
        status, text = self._roh("GET", "/api/app/config")
        if status != 200:
            return None
        try:
            cfg = json.loads(text)["data"]
        except Exception:
            return None
        nutzer = cfg.get("loginServiceConfig", {}).get("user") or {}
        return cfg if nutzer.get("name") else None

    def sicherstellen(self):
        cfg = self._angemeldet()
        if cfg is None:
            self.login()
            cfg = self._angemeldet()
            if cfg is None:
                raise Fehler("Anmeldung hat keine gueltige Session ergeben.")
        return cfg

    def token(self):
        if self._token is None:
            status, text = self._roh("GET", "/api/token/new")
            if status != 200 or not text.strip():
                raise Fehler("Konnte kein Bearer-Token abrufen.")
            self._token = text.strip()
        return self._token

    # -- API ----------------------------------------------------------------

    def hole(self, pfad, bearer=False):
        kopf = {"Authorization": "Bearer " + self.token()} if bearer else None
        status, text = self._roh("GET", pfad, headers=kopf)
        if status == 401 and bearer:
            self._token = None
            kopf = {"Authorization": "Bearer " + self.token()}
            status, text = self._roh("GET", pfad, headers=kopf)
        return status, text

    def hole_json(self, pfad, bearer=False, zweck=""):
        status, text = self.hole(pfad, bearer=bearer)
        if status != 200:
            raise Fehler(fehlertext(status, text, zweck or pfad))
        try:
            return json.loads(text)
        except json.JSONDecodeError:
            raise Fehler(f"Unerwartete Antwort von {pfad}: {text[:200]}")

    def sende_json(self, pfad, daten, bearer=True):
        kopf = {"Authorization": "Bearer " + self.token()} if bearer else None
        status, text = self._roh("POST", pfad, daten=daten, headers=kopf)
        return status, text

    def sende_multipart(self, pfad, daten):
        kopf = {"Authorization": "Bearer " + self.token()}
        status, text = self._roh("POST", pfad, daten=daten, headers=kopf,
                                 content_type="multipart")
        if status == 401:
            self._token = None
            kopf = {"Authorization": "Bearer " + self.token()}
            status, text = self._roh("POST", pfad, daten=daten, headers=kopf,
                                     content_type="multipart")
        return status, text


def multipart_bauen(daten):
    """Ein Part `request` als JSON-Blob -- so schickt es die Weboberflaeche."""
    grenze = "----WebUntisSkill" + uuid.uuid4().hex
    koerper = (
        f"--{grenze}\r\n"
        'Content-Disposition: form-data; name="request"; filename="blob"\r\n'
        "Content-Type: application/json\r\n\r\n"
        + json.dumps(daten, ensure_ascii=False)
        + f"\r\n--{grenze}--\r\n"
    )
    return koerper.encode("utf-8"), grenze


def fehlertext(status, text, zweck):
    if status == 403:
        return (f"{zweck}: Zugriff verweigert (403). Dieser Bereich ist fuer "
                f"Erziehungsberechtigte an dieser Schule nicht freigegeben.")
    if status == 500:
        return (f"{zweck}: Serverfehler (500). Der Endpunkt ist an dieser "
                f"Schule vermutlich nicht aktiv.")
    if status == 404:
        return f"{zweck}: Endpunkt nicht gefunden (404)."
    return f"{zweck}: HTTP {status} -- {text[:200]}"


