def klasse_waehlen(client, wunsch):
    liste = klassen_liste(client)
    for k in liste:
        if str(k["id"]) == str(wunsch) or (k["name"] or "").lower() == wunsch.lower():
            return k
    namen = ", ".join(k["name"] for k in liste)
    raise Fehler(f"Keine Klasse '{wunsch}'. Verfuegbar: {namen}")


def wochenplan(client, element_typ, element_id, von, bis):
    """Holt alle Perioden zwischen von und bis, Woche fuer Woche."""
    perioden, namen = [], {}
    montag = von - timedelta(days=von.weekday())
    while montag <= bis:
        daten = client.hole_json(
            "/api/public/timetable/weekly/data"
            f"?elementType={element_typ}&elementId={element_id}"
            f"&date={montag}&formatId=1",
            zweck="Stundenplan",
        )["data"]["result"]["data"]
        for e in daten.get("elements", []):
            namen[(e["type"], e["id"])] = e.get("name")
        perioden.extend(daten.get("elementPeriods", {}).get(str(element_id), []))
        montag += timedelta(days=7)
    return perioden, namen


def zeit(wert):
    text = f"{int(wert):04d}"
    return f"{text[:2]}:{text[2:]}"


def periode_zeile(periode, namen):
    def teil(typ):
        werte = []
        for ref in periode.get("elements", []):
            if ref["type"] != typ:
                continue
            name = namen.get((typ, ref["id"]), str(ref["id"]))
            if ref.get("orgId"):
                alt = namen.get((typ, ref["orgId"]))
                if alt and alt != name:
                    name = f"{name} (statt {alt})"
            werte.append(name)
        return " ".join(werte)

    spanne = f"{zeit(periode['startTime'])}-{zeit(periode['endTime'])}"
    fach = teil(ELEMENT_FACH) or periode.get("lessonText") or "?"
    lehrer = teil(ELEMENT_LEHRER)
    raum = teil(ELEMENT_RAUM).replace("---", "").strip()
    zustand = ZELLE.get(periode.get("cellState", ""), "")
    # lessonText traegt bei Pruefungen die Art ("SA M"), periodText den Stundeninhalt
    texte = []
    for schluessel in ("lessonText", "periodText", "substText"):
        text = (periode.get(schluessel) or "").strip()
        if text and text != fach and text not in texte:
            texte.append(text)
    zusatz = " · ".join(texte)

    zeile = f"{spanne}  {fach:<8}"
    if lehrer:
        zeile += f" {lehrer:<6}"
    if raum:
        zeile += f" {raum}"
    if zustand:
        zeile += f"  [{zustand}]"
    if zusatz:
        zeile += f"  {zusatz}"
    return zeile.rstrip()


