ELEMENT_KLASSE, ELEMENT_LEHRER, ELEMENT_FACH, ELEMENT_RAUM = 1, 2, 3, 4
ELEMENT_SCHUELER = 5

WOCHENTAG = ["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"]

ZELLE = {
    "CANCEL": "ENTFALL",
    "SUBSTITUTION": "Vertretung",
    "ADDITIONAL": "zusaetzlich",
    "ROOMSUBSTITUTION": "Raumwechsel",
    "SHIFT": "verlegt",
    "FREE": "frei",
    "EXAM": "Pruefung",
}


