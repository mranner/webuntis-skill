# Hilfen
# --------------------------------------------------------------------------

def datum(wert, standard=None):
    if not wert:
        return standard or date.today()
    if wert == "heute":
        return date.today()
    if wert == "morgen":
        return date.today() + timedelta(days=1)
    try:
        return datetime.strptime(wert, "%Y-%m-%d").date()
    except ValueError:
        raise Fehler(f"Datum '{wert}' nicht lesbar, erwartet YYYY-MM-DD.")


def ausgabe(objekt, als_json):
    if als_json:
        print(json.dumps(objekt, ensure_ascii=False, indent=2))
        return True
    return False


def schueler_liste(client):
    daten = client.hole_json(
        "/api/public/timetable/weekly/pageconfig?type=5",
        zweck="Schuelerliste",
    )["data"]
    return [
        {"id": e["id"], "name": e.get("displayname") or e.get("name"),
         "klasse": e.get("klasseId")}
        for e in daten.get("elements", [])
    ]


def schueler_waehlen(client, wunsch):
    liste = schueler_liste(client)
    if not liste:
        raise Fehler("Dem Account ist kein Kind zugeordnet.")
    if not wunsch:
        return liste[0]
    for s in liste:
        if str(s["id"]) == str(wunsch) or wunsch.lower() in (s["name"] or "").lower():
            return s
    namen = ", ".join(f"{s['name']} ({s['id']})" for s in liste)
    raise Fehler(f"Kein Kind passt zu '{wunsch}'. Verfuegbar: {namen}")


