def parser_bauen():
    p = argparse.ArgumentParser(prog="webuntis", description=__doc__)
    p.add_argument("--json", action="store_true", help="Rohdaten als JSON")

    # --json soll vor UND nach dem Subcommand stehen duerfen. Der Elternparser
    # wird an jeden Subparser gehaengt; SUPPRESS verhindert, dass dessen
    # Default das bereits gesetzte --json der obersten Ebene ueberschreibt.
    gemeinsam = argparse.ArgumentParser(add_help=False)
    gemeinsam.add_argument("--json", action="store_true",
                           default=argparse.SUPPRESS,
                           help="Rohdaten als JSON")

    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("setup", parents=[gemeinsam],
                       help="Konfiguration und Schluesselbund einrichten")
    s.add_argument("--server")
    s.add_argument("--school")
    s.add_argument("--username")
    s.add_argument("--force", action="store_true")

    sub.add_parser("whoami", parents=[gemeinsam],
                   help="Login pruefen, Schule und Kinder anzeigen")
    sub.add_parser("students", parents=[gemeinsam],
                   help="Zugeordnete Kinder auflisten")
    sub.add_parser("classes", parents=[gemeinsam],
                   help="Alle Klassen der Schule mit id")

    t = sub.add_parser("timetable", parents=[gemeinsam], help="Stundenplan")
    t.add_argument("--student", help="Name oder id, sonst das erste Kind")
    t.add_argument("--class", dest="klasse",
                   help="Klassenplan statt Schuelerplan, z.B. 2a")
    t.add_argument("--date", help="Startdatum YYYY-MM-DD (Standard: heute)")
    t.add_argument("--days", type=int, default=5)

    n = sub.add_parser("news", parents=[gemeinsam],
                       help="Tagesnachrichten der Schule")
    n.add_argument("--date")

    h = sub.add_parser("homework", parents=[gemeinsam], help="Hausaufgaben")
    h.add_argument("--student", help="Name oder id, sonst alle Kinder")
    h.add_argument("--date")
    h.add_argument("--days", type=int, default=14)

    a = sub.add_parser("absences", parents=[gemeinsam], help="Abwesenheiten")
    a.add_argument("--student", help="Name oder id, sonst alle Kinder")
    a.add_argument("--date")
    a.add_argument("--days", type=int, default=30)

    o = sub.add_parser("officehours", parents=[gemeinsam],
                       help="Sprechstunden der Lehrkraefte")
    o.add_argument("--class", dest="klasse",
                   help="nur Lehrkraefte dieser Klasse, z.B. 2a")
    o.add_argument("--teacher", help="Teil des Namens oder Kuerzels")
    o.add_argument("--date")
    o.add_argument("--weeks", type=int, default=1)

    lk = sub.add_parser("teachers", parents=[gemeinsam],
                        help="Lehrkraefte einer Klasse oder eines Kindes")
    ziel = lk.add_mutually_exclusive_group()
    ziel.add_argument("--class", dest="klasse", help="Klasse, z.B. 2a")
    ziel.add_argument("--student", help="Name oder id, sonst das erste Kind")
    lk.add_argument("--date")

    pd = sub.add_parser("parentsday", parents=[gemeinsam],
                        help="Elternsprechtag: Termine lesen, buchen, stornieren")
    pdsub = pd.add_subparsers(dest="pd_cmd", required=True)
    for name, hilfe in (("info", "Sprechtag, Status, Buchungsfenster"),
                        ("list", "eigene Termine"),
                        ("free", "je Zeit die noch buchbaren Lehrkraefte")):
        x = pdsub.add_parser(name, parents=[gemeinsam], help=hilfe)
        x.add_argument("--id", help="Sprechtag-id, sonst der angekuendigte")
    for name, hilfe in (("book", "Termin buchen"), ("cancel", "Termin stornieren")):
        x = pdsub.add_parser(name, parents=[gemeinsam], help=hilfe)
        x.add_argument("--id", help="Sprechtag-id, sonst der angekuendigte")
        x.add_argument("--teacher", required=True, help="Kuerzel oder Teil des Namens")
        x.add_argument("--time", required=True, help="Beginn HH:MM, z.B. 15:55")

    m = sub.add_parser("messages", parents=[gemeinsam],
                       help="Mitteilungs-Center")
    msub = m.add_subparsers(dest="msg_cmd", required=True)
    ml = msub.add_parser("list", parents=[gemeinsam])
    ml.add_argument("--folder", choices=["inbox", "sent", "drafts"],
                    default="inbox")
    ml.add_argument("--limit", type=int, default=20)
    mr = msub.add_parser("read", parents=[gemeinsam])
    mr.add_argument("id")
    msub.add_parser("recipients", parents=[gemeinsam])
    msub.add_parser("permissions", parents=[gemeinsam])
    ms = msub.add_parser("send", parents=[gemeinsam])
    ms.add_argument("--to", nargs="+", required=True, help="userId(s)")
    ms.add_argument("--subject", required=True)
    ms.add_argument("--body", required=True, help="Text oder '-' fuer stdin")
    ms.add_argument("--dry-run", action="store_true",
                    help="Nutzlast zeigen, nichts senden")
    return p


def main():
    args = parser_bauen().parse_args()
    try:
        if args.cmd == "setup":
            cmd_setup(args)
            return 0
        client = Client(config_laden())
        {"whoami": cmd_whoami, "students": cmd_students,
         "classes": cmd_classes,
         "timetable": cmd_timetable, "news": cmd_news,
         "homework": cmd_homework, "absences": cmd_absences,
         "officehours": cmd_officehours, "teachers": cmd_teachers,
         "messages": cmd_messages, "parentsday": cmd_parentsday}[args.cmd](args, client)
        return 0
    except Fehler as err:
        print(f"Fehler: {err}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
