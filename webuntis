def sprechstunden(client, klasse_id, von, bis):
    """Sprechstunden zwischen von und bis; klasse_id -1 fuer alle Klassen."""
    # Eine Abfrage liefert die Woche ab date (teils etwas mehr) -- Woche fuer
    # Woche holen und doppelte Termine zusammenfassen
    termine, montag = {}, von - timedelta(days=von.weekday())
    while montag <= bis:
        for t in client.hole_json(
            f"/api/public/officehours/hours?date={montag:%Y%m%d}&klasseId={klasse_id}",
            zweck="Sprechstunden",
        )["data"]:
            termine[(t["teacherId"], t["date"], t.get("startTime"))] = t
        montag += timedelta(days=7)
    liste = [t for t in termine.values()
             if t["date"] == 0 or von <= datetime.strptime(str(t["date"]), "%Y%m%d").date() <= bis]
    liste.sort(key=lambda t: (t["date"] == 0, t["date"], t.get("uStartTime") or 0,
                              t.get("teacher") or ""))
    return liste


def kuerzel(lehrkraft):
    """Kuerzel aus "NAME, Vorname (KZ)" -- so verknuepfen sich Sprechstunden und Plan."""
    kz = re.search(r"\(([^)]+)\)\s*$", lehrkraft or "")
    return kz.group(1) if kz else None


def faecher_je_lehrer(client, element_typ, element_id, von, bis):
    """Lehrerkuerzel -> Faecher aus dem Plan, mindestens zwei Wochen (14-taegige Faecher)."""
    perioden, namen = wochenplan(client, element_typ, element_id, von,
                                 max(bis, von + timedelta(days=13)))
    faecher = {}
    for p in perioden:
        lehrer = [namen.get((ELEMENT_LEHRER, e["id"])) for e in p["elements"]
                  if e["type"] == ELEMENT_LEHRER]
        fach = [namen.get((ELEMENT_FACH, e["id"])) for e in p["elements"]
                if e["type"] == ELEMENT_FACH]
        for l in lehrer:
            if l and l.strip("-"):
                faecher.setdefault(l, set()).update(f for f in fach if f)
    return faecher


def sprechstunde_text(t):
    if t["date"] == 0:
        return "nach Vereinbarung"
    tag = datetime.strptime(str(t["date"]), "%Y%m%d").date()
    return f"{WOCHENTAG[tag.weekday()]} {tag:%d.%m.} {t['startTime']}-{t['endTime']}"


def cmd_officehours(args, client):
    client.sicherstellen()
    klasse_id = -1
    if args.klasse:
        klassen = client.hole_json("/api/public/officehours/classes",
                                   zweck="Sprechstunden-Klassen")["data"]
        treffer = [k for k in klassen if str(k["id"]) == str(args.klasse)
                   or k["label"].lower() == args.klasse.lower()]
        if not treffer:
            namen = ", ".join(k["label"] for k in klassen)
            raise Fehler(f"Keine Klasse '{args.klasse}'. Verfuegbar: {namen}")
        klasse_id = treffer[0]["id"]

    von = datum(args.date)
    bis = von + timedelta(weeks=args.weeks) - timedelta(days=1)
    liste = sprechstunden(client, klasse_id, von, bis)
    if args.teacher:
        such = args.teacher.lower()
        liste = [t for t in liste if such in (t.get("teacher") or "").lower()]
    if args.klasse:
        klasse = klasse_waehlen(client, args.klasse)
        faecher = faecher_je_lehrer(client, ELEMENT_KLASSE, klasse["id"], von, bis)
        for t in liste:
            t["subjects"] = sorted(faecher.get(kuerzel(t.get("teacher")), ()))
    if ausgabe(liste, args.json):
        return
    if not liste:
        print(f"Keine Sprechstunden zwischen {von} und {bis}.")
        return
    for t in liste:
        zeile = f"{sprechstunde_text(t):<22}  {t.get('teacher')}"
        if args.klasse:
            zeile += f"  {', '.join(t['subjects']) or '(kein Fach)'}"
        if t.get("rooms"):
            zeile += f"  Raum {t['rooms']}"
        if t.get("registered"):
            zeile += "  [angemeldet]"
        elif t["date"] and not t.get("available"):
            zeile += "  [nicht verfuegbar]"
        print(zeile)


def cmd_teachers(args, client):
    client.sicherstellen()
    if args.klasse:
        ziel = klasse_waehlen(client, args.klasse)
        typ, titel = ELEMENT_KLASSE, f"Klasse {ziel['name']}"
    else:
        ziel = schueler_waehlen(client, args.student)
        typ, titel = ELEMENT_SCHUELER, ziel["name"]
    von = datum(args.date)
    faecher = faecher_je_lehrer(client, typ, ziel["id"], von, von)
    # Namen und Sprechstunden aus allen Klassen -- auch wer in einer anderen
    # Klasse Sprechstunde hat, bekommt so seinen Namen
    stunden = {}
    for t in sprechstunden(client, -1, von, von + timedelta(days=13)):
        stunden.setdefault(kuerzel(t.get("teacher")), []).append(t)
    liste = []
    for kz in sorted(faecher):
        termine = stunden.get(kz, [])
        liste.append({"kuerzel": kz,
                      "name": termine[0]["teacher"].rsplit(" (", 1)[0] if termine else None,
                      "subjects": sorted(faecher[kz]),
                      "officehours": termine})
    if ausgabe(liste, args.json):
        return
    print(f"Lehrkraefte {titel} -- Plan ab {von}, 14 Tage")
    for l in liste:
        zeile = f"{l['kuerzel']:<6} {l['name'] or '?':<28} {', '.join(l['subjects']):<16}"
        if l["officehours"]:
            t = l["officehours"][0]
            zeile += f" {sprechstunde_text(t)}"
            if t.get("rooms"):
                zeile += f"  Raum {t['rooms']}"
        else:
            zeile += " keine Sprechstunde"
        print(zeile.rstrip())


def cmd_messages(args, client):
    client.sicherstellen()
    if args.msg_cmd == "list":
        pfad = {"inbox": "/api/rest/view/v1/messages",
                "sent": "/api/rest/view/v1/messages/sent",
                "drafts": "/api/rest/view/v1/messages/drafts"}[args.folder]
        daten = client.hole_json(pfad, bearer=True, zweck="Mitteilungen")
        schluessel = next((k for k in ("incomingMessages", "sentMessages",
                                       "draftMessages", "messages")
                           if k in daten), None)
        liste = daten.get(schluessel, []) if schluessel else []
        if ausgabe(liste, args.json):
            return
        for m in liste[:args.limit]:
            wer = (m.get("sender") or m.get("recipients") or [{}])
            name = wer.get("displayName") if isinstance(wer, dict) else (
                ", ".join(x.get("displayName", "?") for x in wer))
            print(f"{m['id']}\t{(m.get('sentDateTime') or '')[:10]}\t"
                  f"{name}\t{m.get('subject')}")
    elif args.msg_cmd == "read":
        m = client.hole_json(f"/api/rest/view/v1/messages/{args.id}",
                             bearer=True, zweck="Mitteilung")
        if ausgabe(m, args.json):
            return
        print(f"Von:     {(m.get('sender') or {}).get('displayName')}")
        print(f"Datum:   {m.get('sentDateTime')}")
        print(f"Betreff: {m.get('subject')}\n")
        print(m.get("content") or "")
    elif args.msg_cmd == "recipients":
        gruppen = client.hole_json(
            "/api/rest/view/v1/messages/recipients/static/persons",
            bearer=True, zweck="Empfaenger")
        if ausgabe(gruppen, args.json):
            return
        for gruppe in gruppen:
            personen = gruppe.get("persons") or []
            print(f"\n[{gruppe.get('type')}] {len(personen)}")
            for p in personen:
                print(f"  {p.get('userId')}\t{p.get('displayName')}\t"
                      f"{', '.join(p.get('tags') or [])}")
    elif args.msg_cmd == "permissions":
        rechte = client.hole_json("/api/rest/view/v1/messages/permissions",
                                  bearer=True, zweck="Senderechte")
        if ausgabe(rechte, args.json):
            return
        print(json.dumps(rechte, ensure_ascii=False, indent=2))
    elif args.msg_cmd == "send":
        cmd_send(args, client)


def cmd_send(args, client):
    """Versand ueber denselben Endpunkt wie die Weboberflaeche (v2, multipart)."""
    inhalt = args.body
    if inhalt == "-":
        inhalt = sys.stdin.read()
    nutzlast = {
        "subject": args.subject,
        "content": inhalt,
        "requestConfirmation": False,
        "recipientUserIds": [int(i) for i in args.to],
        "oneDriveAttachments": [],
        "forbidReply": False,
    }
    if args.dry_run:
        print(json.dumps(nutzlast, ensure_ascii=False, indent=2))
        return
    status, text = client.sende_multipart(
        "/api/rest/view/v2/messages/users", nutzlast)
    if status not in (200, 201):
        raise Fehler(fehlertext(status, text, "Senden"))
    print(f"Gesendet. Antwort: {text[:300]}")


def sprechtag_rpc(client, csrf, methode, params):
    """JSON-RPC des Sprechtags: Cookie-Session plus CSRF-Token aus main.do, ohne: 403."""
    status, text = client._roh(
        "POST", "/jsonrpc_web/jsonParentsDayService",
        daten={"id": 0, "method": methode, "params": params, "jsonrpc": "2.0"},
        headers={"X-CSRF-Token": csrf})
    if status != 200:
        raise Fehler(fehlertext(status, text, f"Sprechtag {methode}"))
    antwort = json.loads(text)
    if antwort.get("error"):
        raise Fehler(f"Sprechtag {methode}: {antwort['error']}")
    return antwort["result"]


def uhrzeit(wert):
    return f"{wert // 100:02d}:{wert % 100:02d}"


def cmd_parentsday(args, client):
    client.sicherstellen()
    # Sprechtage und CSRF-Token stehen nur im HTML der Startseite
    status, html = client._roh("GET", "/main.do")
    csrf = re.search(r'name="_csrf" value="([^"]+)"', html)
    if status != 200 or not csrf:
        raise Fehler("Startseite main.do ohne CSRF-Token.")
    csrf = csrf.group(1)
    ids = list(dict.fromkeys(re.findall(r"parentsday/parentview\?selId=(\d+)", html)))
    if args.id:
        pd_id = int(args.id)
    elif len(ids) == 1:
        pd_id = int(ids[0])
    elif not ids:
        raise Fehler("Kein Sprechtag auf der Startseite angekuendigt.")
    else:
        raise Fehler(f"Mehrere Sprechtage ({', '.join(ids)}), mit --id waehlen.")

    meta = sprechtag_rpc(client, csrf, "getParentsDayMetaData", [str(pd_id), -1])
    if args.pd_cmd == "info":
        if ausgabe(meta, args.json):
            return
        print(f"{meta['name']} (id {meta['id']})")
        print(f"Datum:         {meta.get('parentsDayDateRange')}, "
              f"{uhrzeit(meta['minTime'])}-{uhrzeit(meta['maxTime'])}")
        print(f"Status:        {meta.get('state')}")
        print(f"Buchung:       {meta.get('appointmentSelectionDateTimeRange')}")
        return

    if args.pd_cmd == "list":
        slots = sprechtag_rpc(client, csrf, "getParentTimeSlots", [pd_id, -1])
        termine = [s["appointment"] for s in slots if s.get("appointment")]
        if ausgabe(termine, args.json):
            return
        if not termine:
            print("Keine Termine gebucht.")
        for t in termine:
            ts = t["timeSlot"]
            kinder = ", ".join(s["name"] for s in t.get("students", []))
            print(f"{uhrzeit(ts['startTime'])}-{uhrzeit(ts['endTime'])}  "
                  f"{t.get('teacherName'):<24} {', '.join(t.get('subjects') or []):<14} "
                  f"Raum {t.get('roomName') or '?':<5} {kinder}")
        return

    # free, book, cancel: Matrix je Zeitblock ueber die Lehrkraefte, die ein
    # Kind unterrichten -- so fragt die Weboberflaeche
    reg = sprechtag_rpc(client, csrf, "getParentsRegistrationData", [pd_id, -1])
    lehrer = [t["id"] for t in reg["teachers"]
              if any(d.get("isTeachingStudent") for d in t["data"].values())]
    zeilen, spalten = [], {}
    for block in meta["timeBlocks"]:
        matrix = sprechtag_rpc(client, csrf, "getMatrixData",
                               [pd_id, block["id"], -1, lehrer])
        for c in matrix["columns"]:
            spalten[c["id"]] = (c["label"], c["details"][0]["label"]
                                if c.get("details") else c["label"])
        for r in matrix["rows"]:
            zeilen.append({"time": r["label"], "block": block["id"], "slot": r["id"],
                           "booked": r["relations"], "possible": r["possibilities"]})

    def name(i):
        return spalten.get(i, (i, i))[1]

    if args.pd_cmd == "free":
        liste = [{"time": z["time"], "booked": [name(i) for i in z["booked"]],
                  "possible": [name(i) for i in z["possible"]]} for z in zeilen]
        if ausgabe(liste, args.json):
            return
        frei = [z for z in liste if z["possible"]]
        if not frei:
            print("Keine weiteren Termine buchbar.")
        for z in frei:
            print(f"{z['time']}  {', '.join(z['possible'])}")
        return

    # book / cancel
    such = args.teacher.lower()
    treffer = [i for i, (kz, n) in spalten.items()
               if kz.lower() == such or such in n.lower()]
    if len(treffer) != 1:
        kandidaten = ", ".join(f"{spalten[i][0]} ({spalten[i][1]})" for i in treffer)
        raise Fehler(f"Lehrkraft '{args.teacher}' nicht eindeutig: {kandidaten or 'kein Treffer'}")
    lid = treffer[0]
    zeile = next((z for z in zeilen if z["time"] == args.time), None)
    if not zeile:
        raise Fehler(f"Keine Zeit {args.time} am Sprechtag (Format HH:MM).")
    buchen = args.pd_cmd == "book"
    if buchen and lid not in zeile["possible"]:
        raise Fehler(f"{name(lid)} um {args.time} nicht buchbar, siehe 'parentsday free'.")
    if not buchen and lid not in zeile["booked"]:
        raise Fehler(f"Kein Termin bei {name(lid)} um {args.time}.")
    # -1 und [1] schickt die Weboberflaeche so mit, Bedeutung unbekannt
    ergebnis = sprechtag_rpc(client, csrf,
                             "saveAppointment" if buchen else "cancelAppointment",
                             [pd_id, lid, zeile["block"], zeile["slot"], -1, [1]])
    gebucht = any(s["id"] == zeile["slot"] and s.get("appointment")
                  and s["appointment"].get("teacherId") == lid
                  for s in ergebnis.get("timeSlots", []))
    if gebucht != buchen:
        raise Fehler("Server hat geantwortet, die Terminliste zeigt aber keine Aenderung.")
    print(f"{'Gebucht' if buchen else 'Storniert'}: {args.time} {name(lid)}")


